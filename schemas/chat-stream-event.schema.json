{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.tinlynk.dev/chat-stream-event.schema.json",
  "title": "ChatStreamEvent",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "token" },
        "data": { "type": "string" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "tool_call" },
        "data": {
          "type": "object",
          "required": ["name", "arguments", "callId"],
          "properties": {
            "name": { "type": "string" },
            "arguments": {},
            "callId": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "tool_result" },
        "data": {
          "type": "object",
          "required": ["callId", "result"],
          "properties": {
            "callId": { "type": "string" },
            "result": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "done" },
        "data": {
          "type": "object",
          "properties": {
            "usage": { "type": "object", "additionalProperties": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "error" },
        "data": {
          "type": "object",
          "required": ["message"],
          "properties": {
            "message": { "type": "string" },
            "code": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
